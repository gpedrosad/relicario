# Token de https://replicate.com/account/api-tokens
# Solo servidor. Nunca uses NEXT_PUBLIC_ con este valor.
REPLICATE_API_TOKEN=

# Silueta para ubicar cabezas. No regenera caras.
REPLICATE_CUTOUT_MODEL=bria/remove-background

# Solo si el crop 1:1 no cabe en el original. Blanco = generar.
REPLICATE_OUTPAINT_MODEL=black-forest-labs/flux-fill-dev

# Opcional. Si está vacío, el upscale es local (sharp).
REPLICATE_UPSCALE_MODEL=

# 1 = la API de enhance responde JSON con cajas y decisión.
RELICARIO_DEBUG=
