# Token de https://replicate.com/account/api-tokens
# Solo servidor. Nunca uses NEXT_PUBLIC_ con este valor.
REPLICATE_API_TOKEN=

# Recorte de la persona (no altera cara ni pose)
REPLICATE_CUTOUT_MODEL=bria/remove-background

# Rellena con IA el hueco del corazón (outpaint)
REPLICATE_FILL_MODEL=black-forest-labs/flux-fill-pro
